# Employee Management System - Environment Variables Template
# Copy this file to .env.local and fill in real values.
# See SETUP_GUIDE.md for where to obtain each value.
#
# All vars under "Required" are validated at startup by lib/env.ts.

# ─── Required ────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph / SharePoint (Excel sync + Azure AD SSO)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SHAREPOINT_SITE_PATH=
SHAREPOINT_FILE_PATH=

# NinjaOne (device + software sync)
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# NextAuth (Azure AD SSO session signing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# IT Response Agent (Phase 11)
# Base URL of the deployed IT Response Agent API server
IT_RESPONSE_AGENT_URL=https://app-itticketagent-api-prod.azurewebsites.net
# Server-to-server API key (matches AGENT_API_KEY on the agent server)
IT_RESPONSE_AGENT_API_KEY=

# Device inventory + onboarding workbooks.
# Each accepts either a SharePoint URL (Doc.aspx/sharing link) or a plain
# file name to search for on the SHAREPOINT_SITE_PATH site drive.
# Defaults when unset: "IT Team All Data.xlsx" / "Onboarding.xlsx".
DEVICE_INVENTORY_WORKBOOK=
ONBOARDING_WORKBOOK=
# Sheet name overrides (defaults: "Device Inventory", "Onboarding", "Offboarding")
# DEVICE_INVENTORY_SHEET_NAME=
# ONBOARDING_SHEET_NAME=
# OFFBOARDING_SHEET_NAME=

# ─── Optional ────────────────────────────────────────────────────────────────

# NinjaOne region (defaults to 'us' if unset)
# Values: us | eu | oc | ca
NINJA_REGION=us

# NextAuth canonical URL
# Dev: http://localhost:3000
# Prod (Azure App Service): https://app-ems-bp-prod.azurewebsites.net
# Must match the redirect URI registered in the Azure AD App Registration.
# NEXTAUTH_URL=http://localhost:3000

# Public app URL (used in emails, links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# VESTIGIAL — the nightly NinjaOne sync cron is retired (endpoint returns 410
# Gone) and nothing reads this var anymore. Safe to leave unset. Kept only so
# old .env.local files don't look like they're missing something.
# SYNC_CRON_SECRET=

# ─── Inter-office topology workbench (kill-switch) ───────────────────────────
# The /network/inter-office page is a permanent, DB-backed feature (data lives
# in the `office_connections` table + `offices.layout_x/_y`). This flag is now
# only a hard kill-switch: set to 0 to hide the page and its dashboard link
# without removing the code or the data. Enabled by default when unset.
# NEXT_PUBLIC_TEMP_TOPOLOGY=1

# ─── Temporary: DEV-ONLY auth bypass ─────────────────────────────────────────
# Set to "true" to skip Azure AD login and run as a mock admin while developing
# (handy because the Cursor embedded browser can't complete the Microsoft
# sign-in popup). HARD-GATED to non-production: it is ignored whenever
# NODE_ENV=production, so it can never weaken auth in a deployed build.
# Requires a dev-server restart to take effect. REMOVE before shipping.
# NEXT_PUBLIC_DISABLE_AUTH=true
