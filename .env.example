# Employee Management System - Environment Variables Template
# Copy this file to .env.local and fill in real values.
# See SETUP_GUIDE.md for where to obtain each value.
#
# All vars under "Required" are validated at startup by lib/env.ts.

# ─── Required ────────────────────────────────────────────────────────────────

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph / SharePoint (Excel sync + Azure AD SSO)
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
SHAREPOINT_SITE_PATH=
SHAREPOINT_FILE_PATH=

# NinjaOne (device + software sync)
NINJA_CLIENT_ID=
NINJA_CLIENT_SECRET=

# NextAuth (Azure AD SSO session signing)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# IT Response Agent (Phase 11)
# Base URL of the deployed IT Response Agent API server
IT_RESPONSE_AGENT_URL=https://app-itticketagent-api-prod.azurewebsites.net
# Server-to-server API key (matches AGENT_API_KEY on the agent server)
IT_RESPONSE_AGENT_API_KEY=

# ─── Optional ────────────────────────────────────────────────────────────────

# NinjaOne region (defaults to 'us' if unset)
# Values: us | eu | oc | ca
NINJA_REGION=us

# NextAuth canonical URL
# Dev: http://localhost:3000
# Self-hosted prod (Phase 20): https://ems.local
# Must match the redirect URI registered in the Azure AD App Registration.
# NEXTAUTH_URL=http://localhost:3000

# Public app URL (used in emails, links, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret required by the nightly NinjaOne sync cron to call /api/sync/* endpoints.
# In dev: optional. In prod (Phase 20): the Windows Task Scheduler job on the
# production desktop reads this from .env.local and sends it as a Bearer token.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYNC_CRON_SECRET=

# Auvik network sync (Phase 17, optional)
# Set all three of these to enable the Auvik integration. When unset the
# entire feature stays hidden and the Network tab continues to use manual
# entry + CSV import as the only data source.
#   AUVIK_API_USER       — Auvik API user email (recommend a dedicated read-only service account)
#   AUVIK_API_KEY        — long token shown once when generating the key in Auvik
#   AUVIK_TENANT_DOMAIN  — subdomain before .my.auvik.com (e.g. "bennettpless")
# AUVIK_API_BASE_URL is an escape hatch — set it to a full URL only if your
# tenant's API isn't reachable at https://api.{AUVIK_TENANT_DOMAIN}.my.auvik.com/v1
# (e.g. region-host pattern like https://auvikapi.us1.my.auvik.com/v1).
# AUVIK_API_USER=
# AUVIK_API_KEY=
# AUVIK_TENANT_DOMAIN=
# AUVIK_API_BASE_URL=
