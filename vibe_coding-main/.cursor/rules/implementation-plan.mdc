## Code Example: Server Action Pattern

When planning API layer, reference this pattern:

```typescript
// app/actions/[feature-name].ts
'use server';

import { createClient } from '@/lib/supabase/server';
import { revalidatePath } from 'next/cache';
import { createContractSchema } from '@/schemas/contract.schema';
import type { Database } from '@/types/database.types';

type Contract = Database['public']['Tables']['contracts']['Row'];

export async function createContract(formData: FormData) {
  const supabase = await createClient();
  
  // Validate input
  const validatedFields = createContractSchema.safeParse({
    title: formData.get('title'),
    description: formData.get('description'),
    status: formData.get('status'),
  });

  if (!validatedFields.success) {
    return { error: validatedFields.error.flatten().fieldErrors };
  }

  // Insert into database
  const { data, error } = await supabase
    .from('contracts')
    .insert(validatedFields.data)
    .select()
    .single();

  if (error) {
    return { error: { message: error.message } };
  }

  revalidatePath('/contracts');
  return { data };
}
```

## Code Example: TanStack Query Hook Pattern

When planning data fetching, reference this pattern:

```typescript
// lib/queries/[feature-name].ts
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { supabase } from '@/lib/supabase/client';
import type { Database } from '@/types/database.types';

type Contract = Database['public']['Tables']['contracts']['Row'];

export const contractKeys = {
  all: ['contracts'] as const,
  lists: () => [...contractKeys.all, 'list'] as const,
  list: (filters: Record<string, unknown>) => [...contractKeys.lists(), filters] as const,
  details: () => [...contractKeys.all, 'detail'] as const,
  detail: (id: string) => [...contractKeys.details(), id] as const,
};

export function useContracts(status?: string) {
  return useQuery({
    queryKey: contractKeys.list({ status }),
    queryFn: async () => {
      let query = supabase.from('contracts').select('*');
      if (status) query = query.eq('status', status);
      const { data, error } = await query;
      if (error) throw error;
      return data as Contract[];
    },
  });
}

export function useContract(id: string) {
  return useQuery({
    queryKey: contractKeys.detail(id),
    queryFn: async () => {
      const { data, error } = await supabase
        .from('contracts')
        .select('*')
        .eq('id', id)
        .single();
      if (error) throw error;
      return data as Contract;
    },
    enabled: !!id,
  });
}
```

## Code Example: Migration Template

When planning database changes:

```sql
-- supabase/migrations/[timestamp]_create_[feature].sql

-- Create table
CREATE TABLE IF NOT EXISTS public.[table_name] (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  created_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
  updated_at TIMESTAMPTZ DEFAULT NOW() NOT NULL,
  -- Add columns
  title TEXT NOT NULL,
  status TEXT DEFAULT 'draft' CHECK (status IN ('draft', 'pending', 'active', 'completed'))
);

-- Enable RLS
ALTER TABLE public.[table_name] ENABLE ROW LEVEL SECURITY;

-- RLS Policies
CREATE POLICY "Users can view own records"
  ON public.[table_name]
  FOR SELECT
  USING (auth.uid() = user_id);

CREATE POLICY "Users can insert own records"
  ON public.[table_name]
  FOR INSERT
  WITH CHECK (auth.uid() = user_id);

-- Indexes
CREATE INDEX idx_[table_name]_status ON public.[table_name](status);
CREATE INDEX idx_[table_name]_user_id ON public.[table_name](user_id);

-- Updated at trigger
CREATE TRIGGER set_updated_at
  BEFORE UPDATE ON public.[table_name]
  FOR EACH ROW
  EXECUTE FUNCTION public.set_updated_at();
```

## Output Checklist
After creating the implementation plan, verify:
- [ ] Plan file exists: `docs/[feature-name]/implementation-plan.md`
- [ ] Architecture decisions are documented
- [ ] Phase breakdown is clear and logical
- [ ] File structure preview is accurate
- [ ] Dependencies are identified
- [ ] Risks are documented with mitigations

## Next Step
Once the implementation plan is approved, proceed to **Split into Steps** using the `implementation-steps.mdc` rule.

## Context Preservation
When stopping after this step:
- The implementation plan contains the full technical approach
- Resume by reading `docs/[feature-name]/implementation-plan.md`
- The PRD remains the source of truth for requirements
