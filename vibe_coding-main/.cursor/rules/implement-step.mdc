# Implement Step Workflow

## Purpose
Execute a single implementation phase from the step files, with clear verification and documentation.

## Trigger
When the user wants to implement a specific phase (e.g., "implement Phase 1" or "implement 01-db-updates").

## Prerequisites
- Feature documentation exists at `docs/[feature-name]/`
- Step files created via `implementation-steps.mdc` workflow
- Previous phases completed (if dependencies exist)

## Process

### Step 1: Load Context
1. Read `docs/[feature-name]/00-index.md` to understand current state
2. Read the specific phase file (e.g., `01-db-updates.md`)
3. Check status of prerequisite phases

### Step 2: Safety Check
Before implementing, verify:
```bash
git status
```
Ensure a clean working tree. If uncommitted changes exist, commit or stash them first.

### Step 3: Update Status
Mark the phase as "In Progress" in both:
- The phase file header: `## Status: 🟡 In Progress`
- The index file table

### Step 4: Execute Implementation
Follow the planned changes in the phase file:
1. Execute each task in order
2. Check off completed items
3. Note any deviations or decisions made

### Step 5: Verify
Run the verification checklist from the phase file:
```bash
npm run build
```
If errors occur, fix them before proceeding.

### Step 6: Update Documentation
1. Mark phase as complete: `## Status: ✅ Complete`
2. Add implementation notes to the phase file
3. Update `00-index.md` with:
   - Phase status: ✅ Complete
   - Commit hash (after committing)
   - Any architectural decisions made

### Step 7: Commit
```bash
git add .
git commit -m "feat([feature-name]): complete [phase-number]-[phase-name]"
```

## Implementation Patterns by Phase

### Phase 1: Database Updates

**File structure to create:**
```
supabase/
└── migrations/
    └── [timestamp]_[feature_name].sql
```

**Commands to run:**
```bash
# Apply migration
supabase db reset

# Generate types (CRITICAL!)
npm run update-types
```

**Verification:**
```bash
# Check types were generated
cat src/types/database.types.ts | grep "[table_name]"

# Build to verify no type errors
npm run build
```

### Phase 2: API Updates

**File structure to create:**
```
src/
├── schemas/
│   └── [feature].schema.ts
├── app/
│   └── actions/
│       └── [feature].ts
└── lib/
    └── queries/
        └── [feature].ts
```

**Implementation order:**
1. Create Zod schema first (validation)
2. Create server actions (backend)
3. Create query hooks (frontend data fetching)

**Example: Complete Zod Schema**
```typescript
// src/schemas/contract.schema.ts
import { z } from 'zod';

// Create schema with full validation
export const createContractSchema = z.object({
  title: z
    .string()
    .min(1, 'Title is required')
    .max(200, 'Title must be less than 200 characters'),
  description: z
    .string()
    .max(2000, 'Description must be less than 2000 characters')
    .optional()
    .nullable(),
  status: z
    .enum(['draft', 'pending', 'active', 'completed'])
    .default('draft'),
  dueDate: z
    .string()
    .datetime({ message: 'Invalid date format' })
    .optional()
    .nullable(),
  priority: z
    .enum(['low', 'medium', 'high'])
    .default('medium'),
});

// Partial schema for updates
export const updateContractSchema = createContractSchema.partial();

// Filter schema for queries
export const contractFilterSchema = z.object({
  status: z.enum(['draft', 'pending', 'active', 'completed']).optional(),
  priority: z.enum(['low', 'medium', 'high']).optional(),
  search: z.string().optional(),
});

// Type exports
export type CreateContractInput = z.infer<typeof createContractSchema>;
export type UpdateContractInput = z.infer<typeof updateContractSchema>;
export type ContractFilter = z.infer<typeof contractFilterSchema>;
```

**Example: Complete Server Action**
```typescript
// src/app/actions/contract.ts
'use server';

import { createClient } from '@/lib/supabase/server';
import { revalidatePath } from 'next/cache';
import { redirect } from 'next/navigation';
import { 
  createContractSchema, 
  updateContractSchema,
  type CreateContractInput,
} from '@/schemas/contract.schema';
import type { Database } from '@/types/database.types';

type Contract = Database['public']['Tables']['contracts']['Row'];

interface ActionResult<T> {
  data?: T;
  error?: { message: string; fields?: Record<string, string[]> };
}

export async function createContract(
  formData: FormData
): Promise<ActionResult<Contract>> {
  const supabase = await createClient();
  
  // Check authentication
  const { data: { user }, error: authError } = await supabase.auth.getUser();
  if (authError || !user) {
    return { error: { message: 'You must be logged in to create a contract' } };
  }

  // Parse and validate input
  const rawData = {
    title: formData.get('title'),
    description: formData.get('description') || null,
    status: formData.get('status') || 'draft',
    dueDate: formData.get('dueDate') || null,
    priority: formData.get('priority') || 'medium',
  };

  const validatedFields = createContractSchema.safeParse(rawData);

  if (!validatedFields.success) {
    return { 
      error: { 
        message: 'Validation failed',
        fields: validatedFields.error.flatten().fieldErrors as Record<string, string[]>,
      } 
    };
  }

  // Insert into database
  const { data, error } = await supabase
    .from('contracts')
    .insert({
      ...validatedFields.data,
      user_id: user.id,
    })
    .select()
    .single();

  if (error) {
    console.error('Create contract error:', error);
    return { error: { message: 'Failed to create contract. Please try again.' } };
  }

  // Revalidate cache and return
  revalidatePath('/contracts');
  return { data };
}

export async function updateContract(
  id: string,
  formData: FormData
): Promise<ActionResult<Contract>> {
  const supabase = await createClient();
  
  // Build update object only with provided fields
  const updateData: Record<string, unknown> = {};
  const fields = ['title', 'description', 'status', 'dueDate', 'priority'];
  
  for (const field of fields) {
    const value = formData.get(field);
    if (value !== null) {
      updateData[field] = value || null;
    }
  }

  const validatedFields = updateContractSchema.safeParse(updateData);

  if (!validatedFields.success) {
    return { 
      error: { 
        message: 'Validation failed',
        fields: validatedFields.error.flatten().fieldErrors as Record<string, string[]>,
      } 
    };
  }

  const { data, error } = await supabase
    .from('contracts')
    .update(validatedFields.data)
    .eq('id', id)
    .select()
    .single();

  if (error) {
    console.error('Update contract error:', error);
    return { error: { message: 'Failed to update contract. Please try again.' } };
  }

  revalidatePath('/contracts');
  revalidatePath(`/contracts/${id}`);
  return { data };
}

export async function deleteContract(id: string): Promise<ActionResult<boolean>> {
  const supabase = await createClient();

  const { error } = await supabase
    .from('contracts')
    .delete()
    .eq('id', id);

  if (error) {
    console.error('Delete contract error:', error);
    return { error: { message: 'Failed to delete contract. Please try again.' } };
  }

  revalidatePath('/contracts');
  return { data: true };
}
```

**Verification:**
```bash
